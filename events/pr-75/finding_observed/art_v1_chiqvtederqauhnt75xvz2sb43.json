{"data":{"body":"[P1] Import `SCHEMA_VERSION` before validating verdicts. This name is neither imported nor defined in this module, so any valid verdict for the selected reviewer causes `finding_decisions()` to raise `NameError`. Both context generation and publication call this loader, meaning recording any verdict\u2014including `accepted`\u2014blocks subsequent reviews by that reviewer on the PR. Import `SCHEMA_VERSION` from `ai_review_telemetry`.","comment_node_id":"PRRC_kwDOTnh_1M8AAAABACh_mA","finding_digest":"b1e8295907d0f7ef4274c3eace0c81e1d4dd9aca6f5aeb6c3f49d6d24e6c655e","finding_id":"arf_v1_whucswih2d366qtuypvm4deb4h","finding_key":"scripts/load_ai_review_findings.py::finding_decisions::undefined-schema-version","identity_key":"scripts/load_ai_review_findings.py::finding_decisions::undefined-schema-version","line":72,"observation_digest":"9956772135b688daf980f47d32c3f8a909f73cfc9d18f2e0c3e18b23f288cd37","observation_id":"aro_v1_tflhoijvw2env6ma6r6tfq7yve","path":"scripts/load_ai_review_findings.py","prior_finding_id":"","published_at":"2026-10-16T17:49:48Z","review_id":"arr_v1_yvhuzrkwij777qzoms5ybdqc46","reviewed_base_sha":"d2a73448f05b81e6eac22e98a27c2001e6067c5c","reviewed_head_sha":"b4dc094712775c9766210948ace71b5f20f5e19a","reviewer":"codex","start_line":72,"suggestion_id":""},"pull_request":{"number":75},"record_id":"art_v1_chiqvtederqauhnt75xvz2sb43","record_type":"finding_observed","recorded_at":"2026-10-16T17:49:48Z","repository":{"full_name":"aws/aws-durable-execution-ci","id":1316519892},"schema_version":1}
