{"data":{"body":"[P2] Honor an explicit zero limit. With nonempty findings, `max_findings=0` selects the default limit and returns up to 20 entries, violating the documented contract that zero disables inline findings. Apply the default only when the argument is `None`, and add a regression test asserting that zero returns `[]`.","comment_node_id":"","finding_digest":"0fc0d6530800cec33b6ef7b869b9eeef8c5fe92f03a574200f1d0e5a389c0652","finding_id":"arf_v1_b7anmuyiadhmgo3o664gtopo56","finding_key":"scripts/smoke_review_limit.py::select_review_findings::zero-limit-disables-findings","identity_key":"scripts/smoke_review_limit.py::select_review_findings::zero-limit-disables-findings","line":21,"observation_digest":"b0bd1479ac0783db895e445af0ff4c6e715aca95577be33b87dd398269a6e210","observation_id":"aro_v1_wc6ri6nma6b5xck6irnpb72mnz","path":"scripts/smoke_review_limit.py","prior_finding_id":"arf_v1_b7anmuyiadhmgo3o664gtopo56","published_at":"2026-10-16T22:46:48Z","review_id":"arr_v1_arq5t4ncybbiswq46qz542g7in","reviewed_base_sha":"8a06a1e5c82083a9224af9d489ddd030be44d978","reviewed_head_sha":"012653ed37a53f97860edc9e677374aa2adb7e6d","reviewer":"codex","start_line":21,"suggestion_id":"","suppressed":true,"suppression_status":"deferred"},"pull_request":{"number":76},"record_id":"art_v1_2kx6yksguolwuti6ztmrmczpwx","record_type":"finding_observed","recorded_at":"2026-10-16T22:46:48Z","repository":{"full_name":"aws/aws-durable-execution-ci","id":1316519892},"schema_version":1}
