{"data":{"body":"[P2] Honor an explicit zero limit. With nonempty findings, `max_findings=0` selects the default limit and returns up to 20 entries, violating the documented contract that zero disables inline findings. Apply the default only when the argument is `None`, and add a regression test asserting that zero returns `[]`.","comment_node_id":"PRRC_kwDOTnh_1M8AAAABAExe7w","finding_digest":"0fc0d6530800cec33b6ef7b869b9eeef8c5fe92f03a574200f1d0e5a389c0652","finding_id":"arf_v1_b7anmuyiadhmgo3o664gtopo56","finding_key":"scripts/smoke_review_limit.py::select_review_findings::zero-limit-disables-findings","identity_key":"scripts/smoke_review_limit.py::select_review_findings::zero-limit-disables-findings","line":21,"observation_digest":"25307d3b5820572a73524e8ee1023df39a825b089e73de948c0e7cbb320834cc","observation_id":"aro_v1_euyh2o2yeblsu42sj2hocar56o","path":"scripts/smoke_review_limit.py","prior_finding_id":"arf_v1_b7anmuyiadhmgo3o664gtopo56","published_at":"2026-10-16T22:38:41Z","review_id":"arr_v1_rjkja4my5obgo7rl6bbfkjvel7","reviewed_base_sha":"8a06a1e5c82083a9224af9d489ddd030be44d978","reviewed_head_sha":"012653ed37a53f97860edc9e677374aa2adb7e6d","reviewer":"codex","start_line":21,"suggestion_id":"arsg_v1_2uszlesiisombcocprwz3yflwr"},"pull_request":{"number":76},"record_id":"art_v1_j34jy7ye5ta7molclclcui2gju","record_type":"finding_observed","recorded_at":"2026-10-16T22:38:41Z","repository":{"full_name":"aws/aws-durable-execution-ci","id":1316519892},"schema_version":1}
