{"data":{"body":"The docstring states \"Zero disables inline findings,\" but `limit = max_findings or DEFAULT_MAX_FINDINGS` treats `0` as falsy, so `select_review_findings(findings, 0)` silently falls back to `DEFAULT_MAX_FINDINGS` (20) and returns up to 20 items instead of `[]`. This contradicts the documented contract and would defeat a caller's intent to disable findings entirely. Only `None` should trigger the default; distinguish it explicitly from `0`.","comment_node_id":"PRRC_kwDOTnh_1M8AAAABAEx8FQ","finding_digest":"683655962e2235603bbe411a17263fb4132f16efe18465295118b328e2412dd8","finding_id":"arf_v1_na3flfroei2wao56ienbojr7wq","finding_key":"scripts/smoke_review_limit.py::select_review_findings::zero-limit-not-disabling-findings","identity_key":"scripts/smoke_review_limit.py::select_review_findings::zero-limit-not-disabling-findings","line":21,"observation_digest":"19073df974a9ee89a57eb2507993dc21913890aa4e21afe8316a51595ece0c14","observation_id":"aro_v1_dedt36luvhxitjl6wjihte64eg","path":"scripts/smoke_review_limit.py","prior_finding_id":"arf_v1_na3flfroei2wao56ienbojr7wq","published_at":"2026-10-16T22:40:07Z","review_id":"arr_v1_xdjzivpdgm5hfz5olttn7dpboi","reviewed_base_sha":"8a06a1e5c82083a9224af9d489ddd030be44d978","reviewed_head_sha":"012653ed37a53f97860edc9e677374aa2adb7e6d","reviewer":"claude","start_line":21,"suggestion_id":"arsg_v1_qffsr7wked5gsqcmtl26dlzfh6"},"pull_request":{"number":76},"record_id":"art_v1_2w5nno2mmmrq57rfcvvdv4a4fo","record_type":"finding_observed","recorded_at":"2026-10-16T22:40:07Z","repository":{"full_name":"aws/aws-durable-execution-ci","id":1316519892},"schema_version":1}
