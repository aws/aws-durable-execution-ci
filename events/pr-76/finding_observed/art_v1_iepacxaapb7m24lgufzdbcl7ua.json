{"data":{"body":"The docstring promises \"Zero disables inline findings,\" but `limit = max_findings or DEFAULT_MAX_FINDINGS` treats `0` as falsy, so `select_review_findings(findings, 0)` silently falls back to `DEFAULT_MAX_FINDINGS` (20) instead of returning `[]`. Only `None` should trigger the default. Fix by distinguishing `None` from `0` explicitly: `limit = DEFAULT_MAX_FINDINGS if max_findings is None else max_findings`.","comment_node_id":"PRRC_kwDOTnh_1M8AAAABAEvdDA","finding_digest":"683655962e2235603bbe411a17263fb4132f16efe18465295118b328e2412dd8","finding_id":"arf_v1_na3flfroei2wao56ienbojr7wq","finding_key":"scripts/smoke_review_limit.py::select_review_findings::zero-limit-not-disabling-findings","identity_key":"scripts/smoke_review_limit.py::select_review_findings::zero-limit-not-disabling-findings","line":21,"observation_digest":"0a547cfd1715ae039c44174ace971b6f782c29b0108efa554c8a7eac378a259d","observation_id":"aro_v1_bjkhz7ixcwxahhcec5fm5fy3n5","path":"scripts/smoke_review_limit.py","prior_finding_id":"arf_v1_na3flfroei2wao56ienbojr7wq","published_at":"2026-10-16T22:32:42Z","review_id":"arr_v1_rl5nveu34lwzpj7qaknqw2u7a5","reviewed_base_sha":"8a06a1e5c82083a9224af9d489ddd030be44d978","reviewed_head_sha":"012653ed37a53f97860edc9e677374aa2adb7e6d","reviewer":"claude","start_line":21,"suggestion_id":"arsg_v1_niofh6rfk7xpzwgvygzf5jxel7"},"pull_request":{"number":76},"record_id":"art_v1_iepacxaapb7m24lgufzdbcl7ua","record_type":"finding_observed","recorded_at":"2026-10-16T22:32:42Z","repository":{"full_name":"aws/aws-durable-execution-ci","id":1316519892},"schema_version":1}
