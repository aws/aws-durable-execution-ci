{"data":{"body":"`select_review_findings` documents three distinct behaviors (`None` \u2192 default limit, `0` \u2192 disabled/empty, negative \u2192 `ValueError`) but no tests exercise any of them. Without a test asserting `select_review_findings(findings, 0) == []`, the zero-handling regression noted above would ship undetected. Add unit tests covering `None`, `0`, a positive limit smaller than the list, and a negative value.","comment_node_id":"PRRC_kwDOTnh_1M8AAAABAEt-Rg","finding_digest":"557f11e5ee59f100ce2d0e3bc566da264360f1e980532b7b2a661c2503a944d2","finding_id":"arf_v1_kv7rdzpolhyqbtrnby54kzw2ez","finding_key":"scripts/smoke_review_limit.py::select_review_findings::missing-contract-tests","identity_key":"scripts/smoke_review_limit.py::select_review_findings::missing-contract-tests","line":22,"observation_digest":"1b0c960c00cdbd34e53a2bc2ea7e034963c08b4db1f116c63bf66c7cf51c67f4","observation_id":"aro_v1_dmgjmdaazw6tjzj2fpbou7qdjf","path":"scripts/smoke_review_limit.py","prior_finding_id":"","published_at":"2026-10-16T22:28:18Z","review_id":"arr_v1_ibgrcwmd4qexqa7baubya73mt3","reviewed_base_sha":"8a06a1e5c82083a9224af9d489ddd030be44d978","reviewed_head_sha":"012653ed37a53f97860edc9e677374aa2adb7e6d","reviewer":"claude","start_line":14,"suggestion_id":""},"pull_request":{"number":76},"record_id":"art_v1_dpqlbgsmvqcfyhtmqta5kuuggr","record_type":"finding_observed","recorded_at":"2026-10-16T22:28:18Z","repository":{"full_name":"aws/aws-durable-execution-ci","id":1316519892},"schema_version":1}
